{
  "manifest_version": 3,
  "name": "Неоценка Updater",
  "version": "1.1.0",
  "description": "Фоновое обновление объявлений Avito и CIAN",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://www.avito.ru/*",
    "https://www.cian.ru/*",
    "https://54.neocenka.ru/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
