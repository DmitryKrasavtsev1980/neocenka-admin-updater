{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "./types/**/*.ts",
    "./services/**/*.ts",
    "./parsers/**/*.ts",
    "./utils/**/*.ts",
    "./background/**/*.ts",
    "./popup/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
